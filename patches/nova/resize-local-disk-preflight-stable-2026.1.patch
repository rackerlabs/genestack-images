+def _get_flavor_local_disk_layout(flavor):
+    has_ephemeral = flavor.get('ephemeral_gb', 0) > 0
+    has_swap = flavor.get('swap', 0) > 0
+    layout = {}
+    if has_ephemeral:
+        layout['b'] = 'ephemeral'
+    if has_swap:
+        layout['c' if has_ephemeral else 'b'] = 'swap'
+    return layout
+
+
+def get_new_local_disk_slots(current_flavor, new_flavor):
+    """Return local disk slots introduced by a flavor transition."""
+    return (
+        set(_get_flavor_local_disk_layout(new_flavor)) -
+        set(_get_flavor_local_disk_layout(current_flavor))
+    )
+
