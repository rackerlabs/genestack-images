+def supports_local_disk_slot_policy(compute_node):
+    """Return whether a compute node uses libvirt disk slot allocation."""
+    hypervisor_type = compute_node.hypervisor_type
+    return (
+        hypervisor_type is not None and
+        hypervisor_type.lower() in LOCAL_DISK_SLOT_HYPERVISORS
+    )
