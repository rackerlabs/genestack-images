Description: Retry a memcache read once after a disconnected server
 libmemcached closes the failed socket when memcached_get returns a
 connection failure, but Shibboleth immediately propagates the error. Clone
 the client to discard connection and DNS state, then retry the read once.
Author: Rackspace Technology
Forwarded: no
Last-Update: 2026-10-01
Comment: libmemcached 1.1.4 can leak a partial clone if its internal allocation fails.
---
--- a/memcache-store/memcache-store.cpp
+++ b/memcache-store/memcache-store.cpp
@@ -342,6 +342,22 @@ bool MemcacheBase::getMemcache(const char* key, string& dest, uint32_t* flags, b
     memcached_return rv;
     char* result = memcached_get(memc, const_cast<char*>(final_key.c_str()), final_key.length(), &len, flags, &rv);
 
+    if (rv == MEMCACHED_CONNECTION_FAILURE) {
+        const string error(memcached_last_error_message(memc));
+        memcached_st* replacement = memcached_clone(nullptr, memc);
+
+        if (replacement) {
+            m_log.warn("memcache connection failed, replacing client and retrying once: %s", error.c_str());
+
+            // The cloned client has no open sockets or cached DNS results.
+            memcached_free(memc);
+            memc = replacement;
+            result = memcached_get(
+                memc, const_cast<char*>(final_key.c_str()), final_key.length(), &len, flags, &rv
+                );
+        }
+    }
+
     switch (rv) {
         case MEMCACHED_SUCCESS:
             dest = result;
