+bool MemcacheBase::replaceClient(const char* operation, unsigned int retry)
+{
+    const unsigned int delay = retryDelays[retry];
+    const string error(memcached_last_error_message(memc));
+
+    m_log.warn(
+        "Memcache::%s connection failed, retry %u/%u in %u ms: %s",
+        operation, retry + 1, retryCount, delay, error.c_str()
+        );
+
+#ifdef WIN32
+    Sleep(delay);
+#else
+    struct timeval tv = { 0, delay * 1000 };
+    select(0, 0, 0, 0, &tv);
+#endif
+
+    memcached_st* replacement = memcached_clone(nullptr, memc);
+    if (!replacement) {
+        m_log.error(
+            "Memcache::%s unable to replace client for retry %u/%u",
+            operation, retry + 1, retryCount
+            );
+        return false;
+    }
+
+    memcached_free(memc);
+    memc = replacement;
+    return true;
+}
+
+void MemcacheBase::logRecovery(const char* operation, unsigned int retries) const
+{
+    if (retries) {
+        m_log.info(
+            "Memcache::%s recovered after %u retry attempt%s",
+            operation, retries, retries == 1 ? "" : "s"
+            );
+    }
+}
